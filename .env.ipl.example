# IPL Auction dev scripts (npm run ipl:setup / ipl:seed).
# Copy to .env.ipl.local (git-ignored) and fill in. NEVER commit real values.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# Server API key with databases.read/write, tables.read/write, columns.read/write,
# indexes.read/write, rows.read/write scopes. Keep it out of any VITE_ variable.
APPWRITE_API_KEY=
# A SEPARATE database for IPL development (not the existing site database).
IPL_AUCTION_DATABASE_ID=ipl-auction-dev
# Optional: the existing site database ID, so the scripts refuse to touch it.
PROTECTED_DATABASE_ID=
